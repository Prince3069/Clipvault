rules_version = '2';

// MediaNest — Firestore security rules.
//
// How the app uses Firestore:
//   • The Cloud Functions backend (Admin SDK) does almost all the writing.
//     The Admin SDK is NOT subject to these rules, so the backend keeps
//     working no matter how strict they are.
//   • The app itself only ever:
//       - reads its own  users/{uid}  document (premiumExpiry, cloudQuota)
//       - reads / creates / deletes its own  users/{uid}/cloudFiles/{id}
//   Everything else is closed to clients on purpose — subscription status,
//   AI credit counters, budgets, rate limits, coach streaks and purchase
//   records must only ever be changed by the server.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Owner / producer accounts — always Pro. Keep this list identical to
    // OWNER_EMAILS in functions/lib/middleware.js and ownerEmails in
    // lib/providers/premium_provider.dart.
    function isOwnerAccount() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'princenwanozie6666@gmail.com',
             'ifeanyinwanozie6666@gmail.com'
           ];
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    // True while the server-written subscription expiry is in the future.
    function hasActivePremium(uid) {
      return isOwnerAccount()
        || (exists(/databases/$(database)/documents/users/$(uid))
            && userDoc(uid).data.get('premiumExpiry', null) is timestamp
            && userDoc(uid).data.premiumExpiry > request.time);
    }

    function validCloudFile(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'fileName', 'fileSize', 'mimeType', 'storagePath',
               'downloadUrl', 'thumbnailUrl', 'thumbnailPath',
               'uploadDate', 'source', 'isVideo'
             ])
        && d.keys().hasAll(['fileName', 'fileSize', 'storagePath', 'uploadDate', 'isVideo'])
        && d.fileName is string && d.fileName.size() > 0 && d.fileName.size() <= 300
        && d.fileSize is int && d.fileSize > 0 && d.fileSize <= 3221225472   // 3 GB
        && d.isVideo is bool
        && d.uploadDate is timestamp
        && d.storagePath is string
        && d.storagePath.size() <= 600
        // A record may only ever point at a file inside the user's own folder.
        && d.storagePath.matches('^users/' + uid + '/.+')
        && d.get('mimeType', '') is string
        && d.get('source', '') is string
        && d.get('thumbnailUrl', '') is string
        && d.get('thumbnailPath', '') is string
        && d.get('downloadUrl', '') is string;
    }

    // ── User profile document ────────────────────────────────────────────
    match /users/{uid} {
      // The app reads its own subscription / quota fields.
      allow get: if isSelf(uid);
      // Never listable, never writable from a client: premiumExpiry,
      // planId, ownerAccess, coach points/streak, timezone and FCM tokens
      // are all written by the backend only.
      allow list: if false;
      allow create, update, delete: if false;

      // ── Cloud Vault file records ───────────────────────────────────────
      match /cloudFiles/{fileId} {
        // Reading and deleting stay allowed after a subscription lapses,
        // so nobody is locked out of (or unable to clean up) their files.
        allow read: if isSelf(uid);
        allow delete: if isSelf(uid);
        // Adding files needs an active subscription and a well-formed record.
        allow create: if isSelf(uid)
                      && hasActivePremium(uid)
                      && validCloudFile(uid);
        // Records are immutable once written.
        allow update: if false;
      }

      // ── Server-only data ───────────────────────────────────────────────
      // aiCredits, meta (AI budget, coach plan), rateLimits, events,
      // downloadLog, videoAnalysis, coachChallenges, coachIdeas …
      // Reached only through the Cloud Functions API.
      match /{subcollection}/{docId=**} {
        allow read, write: if false;
      }
    }

    // ── Purchase bookkeeping (server-only) ─────────────────────────────────
    match /creditRedemptions/{token} {
      allow read, write: if false;
    }
    match /subscriptionActivations/{token} {
      allow read, write: if false;
    }

    // ── Default: deny everything not explicitly allowed above ─────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
