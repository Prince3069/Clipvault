rules_version = '2';

// MediaNest — Cloud Storage security rules.
//
// The only thing the app stores here is Cloud Vault media, always inside
// the signed-in user's own folder:
//
//   users/{uid}/cloud_vault/…          files uploaded from the Cloud Vault screen
//   users/{uid}/cloud_vault/thumbs/…   their video preview images
//   users/{uid}/videos/…               auto-backed-up downloads
//   users/{uid}/images/…
//   users/{uid}/thumbnails/…
//
// NOTE: hasActivePremium() reads Firestore from Storage rules ("cross-
// service rules"). The first time you deploy/publish these rules Firebase
// asks to grant Storage permission to read Firestore — accept it, or
// uploads will be denied for everyone except the owner accounts.

service firebase.storage {
  match /b/{bucket}/o {

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Owner / producer accounts — always Pro. Keep identical to
    // OWNER_EMAILS in functions/lib/middleware.js.
    function isOwnerAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'princenwanozie6666@gmail.com',
             'ifeanyinwanozie6666@gmail.com'
           ];
    }

    function hasActivePremium(uid) {
      return isOwnerAccount()
        || (firestore.exists(/databases/(default)/documents/users/$(uid))
            && firestore.get(/databases/(default)/documents/users/$(uid)).data.get('premiumExpiry', null) is timestamp
            && firestore.get(/databases/(default)/documents/users/$(uid)).data.premiumExpiry > request.time);
    }

    // Photos and videos only, 500 MB per file at most. (The 3 GB total
    // quota is enforced by the app + the Firestore record rules.)
    function validMedia() {
      return request.resource.size > 0
        && request.resource.size <= 500 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*'));
    }

    match /users/{uid}/{allPaths=**} {
      // Viewing / downloading your own files — also after a subscription
      // lapses, so files are never held hostage.
      allow get: if isSelf(uid);
      allow list: if isSelf(uid);

      // New uploads need an active subscription. `create` only: an
      // existing file can never be silently overwritten.
      allow create: if isSelf(uid)
                    && hasActivePremium(uid)
                    && validMedia();
      allow update: if false;

      // Removing your own files is always allowed.
      allow delete: if isSelf(uid);
    }

    // Everything else in the bucket is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
