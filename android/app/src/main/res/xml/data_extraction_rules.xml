<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/xml/data_extraction_rules.xml -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude files that shouldn't be backed up to cloud -->
        <exclude domain="sharedpref" path="flutter.*.xml"/>
        <exclude domain="database" path="app_flutter"/>
    </cloud-backup>
    <device-transfer>
        <!-- Include/exclude files for device-to-device transfer -->
        <include domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>